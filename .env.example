# Meta Conversions API Configuration (server-side)
META_PIXEL_ID=your_ya_pixel_id_here
META_ACCESS_TOKEN=your_meta_access_token_here
META_API_VERSION=v19.0

# Optional Meta Test Events code (leave unset in normal production)
# META_TEST_EVENT_CODE=

# Meta CAPI origin/host allow-lists (comma-separated)
META_CAPI_ALLOWED_ORIGINS=https://ya.fulanihairsecrets.com
META_CAPI_ALLOWED_SOURCE_HOSTS=ya.fulanihairsecrets.com

# Google Sheets Integration (server-side - used by api/order.ts)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----
SHEET_ID=your_google_sheet_id_here
SHEET_TAB_NAME=YA Orders

# Supabase Reviews Backend (client-side)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional client-side API URLs (defaults are baked into src/config/api.ts)
# VITE_API_BASE_URL=
# VITE_WEBHOOK_URL=
# VITE_WEBHOOK_SECRET=
# VITE_ERPNEXT_BASE_URL=https://vitalvida.systemforce.ng
