# Meta Conversions API Configuration
VITE_META_ACCESS_TOKEN=your_meta_access_token_here
FB_PIXEL_ID=your_fb_pixel_id_here
FB_CAPI_ACCESS_TOKEN=your_fb_capi_access_token_here
FB_CAPI_VERSION=v19.0

# Get your access token from:
# 1. Go to Meta Business Suite → Settings → Developers
# 2. Create an app or use existing one
# 3. Generate a System User access token with 'ads_management' permission
# 4. Copy the token here (it starts with "EAAJZC...")

# API URLs (all optional — defaults are baked into src/config/api.ts)
VITE_API_BASE_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
VITE_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
VITE_WEBHOOK_SECRET=fhg_orders_2024_secret
VITE_CAPI_ENDPOINT=https://apis.fulanihairsecrets.com/meta-capi.php
VITE_ERPNEXT_BASE_URL=https://vitalvida.systemforce.ng

# Klump BNPL Configuration
VITE_KLUMP_PUBLIC_KEY=your_klump_public_key_here

# ERPNext Integration (server-side - used by api/order.ts)
ERPNEXT_INGEST_URL=https://vitalvida.systemforce.ng/api/method/vitalvida.orders.ingest
ERPNEXT_WEBHOOK_SECRET=

# Google Sheets Integration (server-side - used by api/order.ts)
GOOGLE_SERVICE_ACCOUNT_EMAIL=sheets-writer@fulani-orders-sheet.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----
SHEET_ID=your_google_sheet_id_here

# Supabase Reviews Backend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_REVIEWS_ADMIN_PASSWORD=your-secure-admin-password
